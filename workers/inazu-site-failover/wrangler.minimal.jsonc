{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "inazu-site-failover",
  "main": "minimal/worker.mjs",
  "compatibility_date": "2026-05-09",
  "workers_dev": false,
  "routes": [
    { "pattern": "inazu.me/*", "zone_name": "inazu.me" }
  ],
  "build": {
    "command": "node minimal/build.mjs"
  },
  "assets": {
    "directory": "./minimal/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/rotations"],
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROTATIONS", "class_name": "RotationCounter" }]
  },
  "migrations": [
    { "tag": "rotations-v1", "new_sqlite_classes": ["RotationCounter"] }
  ]
}
