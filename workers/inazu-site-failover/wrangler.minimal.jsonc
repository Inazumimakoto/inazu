{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "inazu-site-failover",
  "main": "./minimal/worker.mjs",
  "compatibility_date": "2026-05-09",
  "workers_dev": false,
  "routes": [
    { "pattern": "inazu.me/*", "zone_name": "inazu.me" }
  ],
  "build": {
    "command": "node minimal/build.mjs"
  },
  "durable_objects": {
    "bindings": [{ "name": "CHAT_LEDGER", "class_name": "ChatLedger" }]
  },
  "migrations": [{ "tag": "chat-v1", "new_sqlite_classes": ["ChatLedger"] }],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/chat", "/api/usage"],
    "directory": "./minimal/dist",
    "not_found_handling": "404-page"
  }
}
